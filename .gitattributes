# Normalise line endings: let Git decide text vs binary, store text as LF in the
# repo, and check out platform-native endings. This quiets the "LF will be
# replaced by CRLF" warnings without rewriting history.
* text=auto

# Windows launch/build scripts should keep CRLF on checkout.
*.bat text eol=crlf

# Treat these as binary so Git never tries to normalise or diff them.
*.png binary
*.ico binary
*.wav binary
*.gz binary
*.exe binary
*.zip binary

# Preserve the exact pre-restructure document bytes used by the migration hashes.
# These snapshots intentionally retain their original mixed line endings.
docs/archive/2026-09-18/AGENTS.before-context-routing.md -text
docs/archive/2026-09-18/README.before-context-routing.md -text
